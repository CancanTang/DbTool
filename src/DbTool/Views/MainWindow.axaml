<ursa:UrsaWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:views="clr-namespace:DbTool.Views"
                 xmlns:loc="clr-namespace:DbTool.Localization"
                 xmlns:ursa="https://irihi.tech/ursa"
                 x:Class="DbTool.Views.MainWindow"
                 mc:Ignorable="d"
                 Title="DbTool"
                 Width="1200"
                 Height="800"
                 MinHeight="700"
                 MinWidth="1000">
  <TabControl>
    <TabItem Header="{loc:Localizer DbFirst}">
      <views:DbFirstView DataContext="{Binding DbFirst}" />
    </TabItem>
    <TabItem Header="{loc:Localizer ModelFirst}">
      <views:ModelFirstView DataContext="{Binding ModelFirst}" />
    </TabItem>
    <TabItem Header="{loc:Localizer CodeFirst}">
      <views:CodeFirstView DataContext="{Binding CodeFirst}" />
    </TabItem>
    <TabItem Header="{loc:Localizer Settings}">
      <views:SettingsView DataContext="{Binding}" />
    </TabItem>
  </TabControl>
</ursa:UrsaWindow>
